#!/bin/sh
# .githooks/pre-commit
#
# Runs before every `git commit`.
#
# Auto-formats staged Dart files and re-stages them so the committed code is
# always in canonical dart format form. CI runs the same formatter; this
# eliminates the "formatted locally ≠ formatted on CI" class of failures.
#
# To bypass in an emergency (not recommended):
#   git commit --no-verify

set -e

BOLD='\033[1m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Block signing material / credentials from ever being committed (public repo).
BAD=$(git diff --cached --name-only --diff-filter=ACM | grep -iE '\.(jks|keystore|p12|p8|pem|cer|mobileprovision)$|(^|/)key\.properties$|service-account.*\.json$|google-services\.json$|GoogleService-Info\.plist$|(^|/)\.env' || true)
if [ -n "$BAD" ]; then
  echo "${YELLOW}${BOLD}[pre-commit]${NC} BLOCKED: secret/signing files staged:"
  echo "$BAD"
  exit 1
fi

echo "${YELLOW}${BOLD}[pre-commit]${NC} Formatting Dart files…"

# Format lib/ and test/ in-place.
dart format lib test 2>&1

# Re-stage any files that dart format changed so the commit captures the
# canonical format, not the pre-format version.
CHANGED=$(git diff --name-only lib test 2>/dev/null || true)
if [ -n "$CHANGED" ]; then
  echo "$CHANGED" | xargs git add
  COUNT=$(echo "$CHANGED" | wc -l | tr -d ' ')
  echo "${YELLOW}${BOLD}[pre-commit]${NC} Re-staged ${COUNT} reformatted file(s)."
fi

echo "${GREEN}${BOLD}[pre-commit] ✓ Formatting OK${NC}"
